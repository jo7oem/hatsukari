{{ define "index" -}}
<section>
  <h1>最新記事</h1>
  <ul>
    {{ range .Posts }}
      <li>
        {{ if .Cover }}
          <img src="{{ coverURL .Cover .Slug }}" alt="{{ .Title }}" loading="lazy" decoding="async" style="max-width:240px;height:auto;" />
        {{ end }}
        <a href="/posts/{{ .Slug }}/">{{ .Title }}</a>
        <small><time datetime="{{ .Date | dateISO }}">{{ .Date | dateJST }}</time></small>
        <p>{{ .Summary }}</p>
      </li>
    {{ end }}
  </ul>
</section>
{{- end }}
